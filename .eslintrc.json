{
  "extends": ["next/core-web-vitals", "next/typescript", "prettier"],
  "ignorePatterns": ["next-env.d.ts", ".next/", "node_modules/"],
  "rules": {
    "@typescript-eslint/no-explicit-any": "error",
    "max-lines": [
      "error",
      {
        "max": 300,
        "skipBlankLines": true,
        "skipComments": true
      }
    ]
  }
}
